# ─────────────────────────────────────────────
#  CrickLive — Environment Variables Template
#  Copy to .env and fill in values. Never commit .env.
# ─────────────────────────────────────────────

# PostgreSQL
POSTGRES_USER=cricklive
POSTGRES_PASSWORD=change_me_in_prod
POSTGRES_DB=cricklive

# pgAdmin
PGADMIN_EMAIL=admin@cricklive.dev
PGADMIN_PASSWORD=change_me_in_prod

# MongoDB
MONGO_USERNAME=cricklive
MONGO_PASSWORD=change_me_in_prod

# Redis
REDIS_PASSWORD=change_me_in_prod

# MinIO
MINIO_ACCESS_KEY=cricklive
MINIO_SECRET_KEY=change_me_in_prod

# JWT
JWT_SECRET=change_me_at_least_256_bits_long_for_production
JWT_EXPIRY_MS=86400000

# Services
MATCH_SERVICE_PORT=8082
SCORING_SERVICE_PORT=8083
COMMENTARY_SERVICE_PORT=8084
STATS_SERVICE_PORT=8085
PLAYER_SERVICE_PORT=8086
TEAM_SERVICE_PORT=8087
SERIES_SERVICE_PORT=8088
VENUE_SERVICE_PORT=8089
NEWS_SERVICE_PORT=8091
USER_SERVICE_PORT=8092
NOTIFICATION_SERVICE_PORT=8093
SEARCH_SERVICE_PORT=8094
MEDIA_SERVICE_PORT=8095
